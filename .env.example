# Optional. docker compose reads .env from the repository root; every value has a local default
# in compose.yaml, so copy this only to change one.
MYSQL_DATABASE=baithak
MYSQL_USER=baithak
MYSQL_PASSWORD=baithak
MYSQL_ROOT_PASSWORD=change-me
DJANGO_SECRET_KEY=dev-only-not-a-secret
# Leave empty to print email to the worker log. Set a Resend API key to send real mail.
RESEND_API_KEY=
