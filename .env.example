# Copy to .env (git ignores it). docker compose reads it from the repository root; every value
# has a local default in compose.yaml, so an empty .env also works.

# MySQL. These are used only when the data volume is first created; changing them later needs
# `docker compose down -v` (which deletes local data).
MYSQL_DATABASE=baithak
MYSQL_USER=baithak
MYSQL_PASSWORD=baithak
MYSQL_ROOT_PASSWORD=change-me

# Django. Make a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Email through Resend (https://resend.com/api-keys, sending access for ahmershah.dev).
# Leave empty to print email to the worker log instead.
RESEND_API_KEY=

# Google reCAPTCHA (https://www.google.com/recaptcha/admin). Create one v3 key and one v2
# "I'm not a robot" checkbox key, both with localhost and baithak.ahmershah.dev as domains.
# Leave all four empty to turn the check off locally.
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=

# "Continue with Google" (https://console.cloud.google.com/apis/credentials): an OAuth client
# ID for a web application, with this authorized redirect URI:
#   http://localhost:5173/api/v1/auth/oidc/google/callback/
# and https://baithak.ahmershah.dev/api/v1/auth/oidc/google/callback/ in production.
# Leave both empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
